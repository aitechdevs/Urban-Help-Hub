APP_NAME=UrbanHelpHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
FRONTEND_URLS=https://yourdomain.com,https://www.yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanel_database_name
DB_USERNAME=cpanel_database_user
DB_PASSWORD=replace_with_strong_password

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Used only by `php artisan db:seed --force` to create the first administrator.
# Choose a unique email and a strong password before deployment.
MVP_ADMIN_NAME="UrbanHelpHub Administrator"
MVP_ADMIN_EMAIL=admin@yourdomain.com
MVP_ADMIN_PASSWORD=replace_with_a_long_unique_password

MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@yourdomain.com
MAIL_PASSWORD=replace_with_mailbox_password
MAIL_SCHEME=smtps
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME=UrbanHelpHub

# Stripe Connect marketplace configuration. Never commit live values.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_COMMISSION_PERCENT=30
STRIPE_FRONTEND_URL=https://urbanhelphub.com

# Indicative MVP exchange-rate overrides: CAD represented by one unit.
# Update these before accepting real payments or replace them with provider rates.
FX_USD_TO_CAD=1.36
FX_GBP_TO_CAD=1.84
FX_EUR_TO_CAD=1.58
FX_NGN_TO_CAD=0.00095
