diff --git a/backend-api/app/Services/TaskPayments.php b/backend-api/app/Services/TaskPayments.php
new file mode 100644
index 0000000..8b0f094
--- /dev/null
+++ b/backend-api/app/Services/TaskPayments.php
@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Services;
+
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class TaskPayments
+{
+    public const CURRENCIES = ['AUD', 'BRL', 'CAD', 'CHF', 'CZK', 'DKK', 'EUR', 'GBP', 'HKD', 'ILS', 'MXN', 'MYR', 'NOK', 'NZD', 'PHP', 'PLN', 'SEK', 'SGD', 'THB', 'USD'];
+
+    public static function minor(string|float|int $amount): int
+    {
+        if (!preg_match('/^(\d+)(?:\.(\d{1,2}))?$/D', (string) $amount, $parts)) {
+            return 0;
+        }
+        return ((int) $parts[1] * 100) + (int) str_pad($parts[2] ?? '', 2, '0');
+    }
+
+    public static function money(int $minor): string
+    {
+        return sprintf('%d.%02d', intdiv($minor, 100), $minor % 100);
+    }
+
+    public function commitmentVerified(object $payment): bool
+    {
+        return in_array($payment->status, ['partially_paid', 'paid'], true)
+            && DB::table('payment_installments')->where('payment_id', $payment->id)
+                ->whereIn('stage', ['commitment', 'full'])->where('status', 'completed')
+                ->whereNotNull('paypal_capture_id')->exists();
+    }
+
+    public function create(object $task, object $assignment): int
+    {
+        // The task row is locked by the quotation confirmation transaction.
+        abort_if(DB::table('payments')->where('task_id', $task->id)->exists()
+            || DB::table('payouts')->where('task_id', $task->id)->exists(),
+            409, 'A payment or payout already exists for this task.');
+
+        $currency = $task->currency ?: 'CAD';
+        $total = self::minor($assignment->agreed_fixed_price ?? 0);
+        if (! in_array($currency, self::CURRENCIES, true) || $total < 2) {
+            throw ValidationException::withMessages(['assignment_id' => 'A fixed quote of at least 0.02 in a supported PayPal currency is required.']);
+        }
+        $fee = intdiv($total * 40 + 50, 100);
+        $helper = $total - $fee;
+        $rate = (float) config("currency.rates_to_cad.{$currency}", 0);
+        if ($rate <= 0) {
+            throw ValidationException::withMessages(['currency' => 'A CAD reporting exchange rate is required for this currency.']);
+        }
+        $now = now();
+        $paymentId = DB::table('payments')->insertGetId([
+            'task_id' => $task->id, 'customer_id' => $task->customer_id, 'helper_id' => $assignment->helper_id,
+            'provider' => 'paypal', 'paypal_mode' => config('services.paypal.mode'), 'commission_percent' => 40, 'currency' => $currency, 'subtotal_amount' => self::money($total),
+            'total_amount' => self::money($total), 'platform_fee' => self::money($fee), 'tax_amount' => 0,
+            'settlement_currency' => 'CAD', 'settlement_exchange_rate' => $rate,
+            'settlement_subtotal_amount' => round($total / 100 * $rate, 2),
+            'settlement_total_amount' => round($total / 100 * $rate, 2),
+            'settlement_platform_fee' => round($fee / 100 * $rate, 2),
+            'settlement_helper_net' => round($helper / 100 * $rate, 2),
+            'status' => 'pending', 'created_at' => $now, 'updated_at' => $now,
+        ]);
+        $deposit = intdiv($total + 1, 2);
+        foreach (['commitment' => $deposit, 'balance' => $total - $deposit] as $stage => $amount) {
+            DB::table('payment_installments')->insert([
+                'payment_id' => $paymentId, 'stage' => $stage, 'amount_minor' => $amount,
+                'request_id' => (string) Str::uuid(), 'created_at' => $now, 'updated_at' => $now,
+            ]);
+        }
+        DB::table('payouts')->insert([
+            'payment_id' => $paymentId, 'task_id' => $task->id, 'helper_id' => $assignment->helper_id,
+            'provider' => 'paypal', 'currency' => $currency, 'gross_amount' => self::money($total),
+            'platform_deduction' => self::money($fee), 'other_deductions' => 0, 'net_amount' => self::money($helper),
+            'status' => 'pending', 'created_at' => $now, 'updated_at' => $now,
+        ]);
+
+        return $paymentId;
+    }
+}
diff --git a/backend-api/app/Support/TaskMatching.php b/backend-api/app/Support/TaskMatching.php
new file mode 100644
index 0000000..b9fe9f6
--- /dev/null
+++ b/backend-api/app/Support/TaskMatching.php
@@ -0,0 +1,120 @@
+<?php
+
+namespace App\Support;
+
+use Illuminate\Database\Query\Builder;
+use Illuminate\Support\Facades\DB;
+use stdClass;
+
+class TaskMatching
+{
+    public static function offerOpenTasks(int $helperId): void
+    {
+        DB::table('tasks')
+            ->where('status', 'open')
+            ->whereNotNull('published_at')
+            ->whereIn('service_category_id', DB::table('helper_services')
+                ->where('user_id', $helperId)
+                ->where('approval_status', 'approved')
+                ->where('is_active', true)
+                ->select('service_category_id'))
+            ->select('id')
+            ->eachById(function (stdClass $candidate) use ($helperId): void {
+                DB::transaction(function () use ($candidate, $helperId): void {
+                    $task = DB::table('tasks')->where('id', $candidate->id)->lockForUpdate()->first();
+                    if ($task && $task->status === 'open' && $task->published_at !== null) {
+                        self::offer($task, $helperId);
+                    }
+                }, 3);
+            });
+    }
+
+    // Callers hold the task row lock while creating offers and notifications.
+    public static function offer(stdClass $task, ?int $helperId = null, bool $reoffer = false): int
+    {
+        $helpers = self::eligibleHelpers($task, $helperId)->get(['users.id', 'helper_services.hourly_rate']);
+
+        $matched = 0;
+        foreach ($helpers as $helper) {
+            $assignment = DB::table('task_assignments')
+                ->where('task_id', $task->id)
+                ->where('helper_id', $helper->id);
+            $now = now();
+            $offer = [
+                'status' => 'offered',
+                'agreed_hourly_rate' => $helper->hourly_rate,
+                'agreed_fixed_price' => null,
+                'accepted_at' => null,
+                'assigned_at' => $now,
+                'updated_at' => $now,
+            ];
+
+            if ($assignment->exists()) {
+                if (!$reoffer || !$assignment->whereIn('status', ['not_selected', 'declined'])->update($offer)) {
+                    continue;
+                }
+            } else {
+                DB::table('task_assignments')->insert($offer + [
+                    'task_id' => $task->id,
+                    'helper_id' => $helper->id,
+                    'created_at' => $now,
+                ]);
+            }
+
+            InAppNotification::send(
+                (int) $helper->id,
+                'new_opportunity',
+                'New job opportunity',
+                'A new “'.$task->title.'” task matches your services and location.',
+                '/helper/dashboard',
+                ['task_id' => $task->id]
+            );
+            $matched++;
+        }
+
+        return $matched;
+    }
+
+    public static function helperIsEligible(stdClass $task, int $helperId): bool
+    {
+        return self::eligibleHelpers($task, $helperId)->exists();
+    }
+
+    private static function eligibleHelpers(stdClass $task, ?int $helperId): Builder
+    {
+        return DB::table('helper_services')
+            ->join('users', 'helper_services.user_id', '=', 'users.id')
+            ->join('profiles', 'users.id', '=', 'profiles.user_id')
+            ->where('helper_services.service_category_id', $task->service_category_id)
+            ->where('helper_services.approval_status', 'approved')
+            ->where('helper_services.is_active', true)
+            ->where('users.role', 'helper')
+            ->where('users.status', 'active')
+            ->where('users.currency_code', $task->currency ?: 'CAD')
+            ->where('profiles.verification_status', 'verified')
+            ->whereRaw('LOWER(profiles.country) = LOWER(?)', [$task->country])
+            ->whereIn(DB::raw('LOWER(profiles.province)'), self::provinceAliases($task->country, $task->province))
+            ->whereRaw('LOWER(profiles.city) = LOWER(?)', [$task->city])
+            ->when($helperId !== null, fn ($query) => $query->where('users.id', $helperId));
+    }
+
+    private static function provinceAliases(?string $country, ?string $province): array
+    {
+        $normalized = strtolower(trim((string) $province));
+        if (strtolower(trim((string) $country)) !== 'canada') {
+            return [$normalized];
+        }
+        $canada = [
+            'ab' => 'alberta', 'bc' => 'british columbia', 'mb' => 'manitoba',
+            'nb' => 'new brunswick', 'nl' => 'newfoundland and labrador', 'ns' => 'nova scotia',
+            'nt' => 'northwest territories', 'nu' => 'nunavut', 'on' => 'ontario',
+            'pe' => 'prince edward island', 'qc' => 'quebec', 'sk' => 'saskatchewan', 'yt' => 'yukon',
+        ];
+        foreach ($canada as $code => $name) {
+            if ($normalized === $code || $normalized === $name) {
+                return [$code, $name];
+            }
+        }
+        return [$normalized];
+    }
+}
diff --git a/backend-api/app/Support/TaskScheduleDate.php b/backend-api/app/Support/TaskScheduleDate.php
