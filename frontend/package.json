{
  "name": "urbanhelphub-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "next build",
    "start": "node server.mjs",
    "lint": "node --check server.mjs && node --check runtime/static-bridge.mjs && node --check runtime/local-api.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:static": "python3 static-maintenance/tests/validate-static.py",
    "build:static": "node runtime/build-static.mjs",
    "test:smoke": "node tests/runtime-smoke.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
